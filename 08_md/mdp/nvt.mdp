; nvt.mdp — 100 ps NVT，300 K，重原子位置限制
define      = -DPOSRES
integrator  = md
dt          = 0.002
nsteps      = 50000
nstxout     = 500
nstvout     = 500
nstenergy   = 500
nstlog      = 500
cutoff-scheme = Verlet
nstlist     = 10
coulombtype = PME
rcoulomb    = 1.2
rvdw        = 1.2
pbc         = xyz
tcoupl      = V-rescale
tc-grps     = Protein Non-Protein
tau_t       = 0.1 0.1
ref_t       = 300 300
pcoupl      = no
gen_vel     = yes
gen_temp    = 300
gen_seed    = 1234
constraints = h-bonds
